# ---------------------------------------------------------------------------
# BROWSER (Vite) — bundled into the client, safe to be public
# ---------------------------------------------------------------------------
# These are Firebase *web* config values. They are not secrets: they ship in
# the client bundle by design. Real protection lives in firestore.rules.
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_FIRESTORE_DATABASE_ID=your-named-database-id

# ---------------------------------------------------------------------------
# SERVER (Vercel serverless) — SECRETS, set in the Vercel dashboard only.
# NEVER commit these or add them to .env.production.
# ---------------------------------------------------------------------------
# Firebase console → Project Settings → Service Accounts → Generate new private key.
# Needed by /api/church-accounts to provision church rep logins.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Paste the private_key value from the JSON. Keep the surrounding quotes.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Only if you use a non-default named Firestore database.
FIRESTORE_DATABASE_ID=your-named-database-id
